SERVICE_NAME=upload-service
ENVIRONMENT=local

AWS_REGION=eu-central-1
# LocalStack endpoint serving both S3 and DynamoDB locally
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET_NAME=upload-service-media
DYNAMODB_TABLE_NAME=upload-service-uploads

MAX_UPLOAD_SIZE_BYTES=5368709120
# JSON array — pydantic-settings parses list-typed env vars as JSON
ALLOWED_CONTENT_TYPE_PREFIXES=["video/","audio/"]
DEFAULT_THUMBNAIL_S3_KEY=_defaults/default-thumbnail.png
SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:000000000000:upload-events

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_METRICS_PORT=9464
